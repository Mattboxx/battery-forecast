<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
<DrawingImage x:Key="AppBrandIcon" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation">
  <DrawingImage.Drawing>
    <DrawingGroup>
      <GeometryDrawing Geometry="M0,0 H1024 V1024 H0 Z" Brush="Transparent"/>
      <GeometryDrawing>
        <GeometryDrawing.Geometry>
          <RectangleGeometry Rect="64,64,896,896" RadiusX="208" RadiusY="208"/>
        </GeometryDrawing.Geometry>
        <GeometryDrawing.Brush>
          <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#1A1C48" Offset="0"/>
            <GradientStop Color="#3D2F7A" Offset="0.55"/>
            <GradientStop Color="#C2664A" Offset="1"/>
          </LinearGradientBrush>
        </GeometryDrawing.Brush>
        <GeometryDrawing.Pen>
          <Pen Brush="#1AFFFFFF" Thickness="8"/>
        </GeometryDrawing.Pen>
      </GeometryDrawing>
      <GeometryDrawing Brush="#0FFFFFFF">
        <GeometryDrawing.Geometry>
          <RectangleGeometry Rect="196,332,584,360" RadiusX="84" RadiusY="84"/>
        </GeometryDrawing.Geometry>
        <GeometryDrawing.Pen>
          <Pen Brush="White" Thickness="44"/>
        </GeometryDrawing.Pen>
      </GeometryDrawing>
      <GeometryDrawing Brush="White">
        <GeometryDrawing.Geometry>
          <RectangleGeometry Rect="804,448,52,128" RadiusX="24" RadiusY="24"/>
        </GeometryDrawing.Geometry>
      </GeometryDrawing>
      <GeometryDrawing Geometry="M262,626 L262,412 C340,414 400,436 452,478 C488,507 512,530 540,546 L540,626 Z">
        <GeometryDrawing.Brush>
          <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#FFE08A" Offset="0"/>
            <GradientStop Color="#F59A3C" Offset="1"/>
          </LinearGradientBrush>
        </GeometryDrawing.Brush>
      </GeometryDrawing>
      <GeometryDrawing Geometry="M540,546 C590,575 650,596 714,612">
        <GeometryDrawing.Pen>
          <Pen Brush="#FFE08A" Thickness="26" StartLineCap="Round" EndLineCap="Round" DashCap="Round">
            <Pen.DashStyle>
              <DashStyle Dashes="0.077,1.77"/>
            </Pen.DashStyle>
          </Pen>
        </GeometryDrawing.Pen>
      </GeometryDrawing>
      <GeometryDrawing Brush="White">
        <GeometryDrawing.Geometry>
          <EllipseGeometry Center="540,546" RadiusX="22" RadiusY="22"/>
        </GeometryDrawing.Geometry>
      </GeometryDrawing>
    </DrawingGroup>
  </DrawingImage.Drawing>
</DrawingImage>

    <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="DisplayFont">Segoe UI Variable Display, Segoe UI</FontFamily>

    <Style x:Key="FocusRing">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Margin="-2" CornerRadius="8" BorderThickness="2" BorderBrush="{DynamicResource Focus}"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Carattere e colore si ereditano dalla finestra (AppWindow): uno stile implicito per TextBlock
         sovrascriverebbe anche i testi dentro i template dei pulsanti e delle caselle. -->
    <Style x:Key="AppWindow" TargetType="Window">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{DynamicResource Text}"/>
        <Setter Property="Background" Value="{DynamicResource WindowBg}"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
        <Setter Property="Icon" Value="{StaticResource AppBrandIcon}"/>
    </Style>

    <Style x:Key="Body" TargetType="TextBlock">
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Typography.NumeralAlignment" Value="Tabular"/>
    </Style>
    <Style x:Key="Secondary" TargetType="TextBlock" BasedOn="{StaticResource Body}">
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
    </Style>
    <Style x:Key="Footnote" TargetType="TextBlock" BasedOn="{StaticResource Secondary}">
        <Setter Property="FontSize" Value="12"/>
    </Style>
    <Style x:Key="SectionTitle" TargetType="TextBlock" BasedOn="{StaticResource Secondary}">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style x:Key="Eyebrow" TargetType="TextBlock" BasedOn="{StaticResource Body}">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
        <Setter Property="Typography.Capitals" Value="AllSmallCaps"/>
        <Setter Property="TextWrapping" Value="NoWrap"/>
    </Style>
    <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
    <Style x:Key="Glyph" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="AutomationProperties.Name" Value=""/>
    </Style>

    <!-- Riga di menu con icona (Tag = glifo di Segoe Fluent Icons) -->
    <Style x:Key="IconRow" TargetType="Button">
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
        <Setter Property="Foreground" Value="{DynamicResource Text}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" Background="Transparent" CornerRadius="8" Padding="14,8">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{TemplateBinding Tag}" Style="{StaticResource Glyph}" Foreground="{DynamicResource Icon}"
                                       Width="18" Margin="0,0,12,0"/>
                            <ContentPresenter VerticalAlignment="Center" TextElement.FontSize="13"/>
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource RowHover}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource RowHover}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Pulsante a sola icona (Content = glifo): il nome per gli screen reader e il suggerimento vanno sul pulsante.
         Vale anche per ToggleButton, che resta evidenziato quando è attivo. -->
    <Style x:Key="IconButton" TargetType="ButtonBase">
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
        <Setter Property="Foreground" Value="{DynamicResource Icon}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Height" Value="34"/>
        <Setter Property="ToolTipService.InitialShowDelay" Value="400"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ButtonBase">
                    <Border x:Name="Bg" Background="Transparent" CornerRadius="8">
                        <TextBlock Text="{TemplateBinding Content}" Style="{StaticResource Glyph}" FontSize="16"
                                   Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource RowHover}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource RowHover}"/>
                        </Trigger>
                        <Trigger Property="ToggleButton.IsChecked" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource RowHover}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Headline" TargetType="TextBlock" BasedOn="{StaticResource Body}">
        <Setter Property="FontFamily" Value="{StaticResource DisplayFont}"/>
        <Setter Property="FontSize" Value="28"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style x:Key="Strong" TargetType="TextBlock" BasedOn="{StaticResource Body}">
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource CardBg}"/>
        <Setter Property="CornerRadius" Value="14"/>
        <Setter Property="Padding" Value="16,14"/>
    </Style>

    <!-- Riga di menu: tutta la larghezza, evidenziazione al passaggio e al focus da tastiera -->
    <Style x:Key="MenuRow" TargetType="Button">
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
        <Setter Property="Foreground" Value="{DynamicResource Text}"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" Background="Transparent" CornerRadius="6" Padding="14,7">
                        <ContentPresenter TextElement.FontSize="13"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource RowHover}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource RowHover}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="LinkButton" TargetType="Button">
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
        <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <TextBlock x:Name="T" Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" FontSize="12"/>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="T" Property="TextDecorations" Value="Underline"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PillButton" TargetType="Button">
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
        <Setter Property="Foreground" Value="{DynamicResource AccentText}"/>
        <Setter Property="Background" Value="{DynamicResource Accent}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="8" Padding="14,6">
                        <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}" TextElement.FontSize="12"
                                          TextElement.FontWeight="SemiBold" HorizontalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Opacity" Value="0.88"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
