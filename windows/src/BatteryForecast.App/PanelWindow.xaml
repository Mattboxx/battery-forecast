<Window x:Class="BatteryForecast.App.PanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="clr-namespace:BatteryForecast.App"
        Title="Battery Forecast" Width="384" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        Style="{StaticResource AppWindow}" BorderBrush="{DynamicResource WindowBorder}" BorderThickness="1" ShowActivated="True"
        AutomationProperties.Name="Battery Forecast">
    <WindowChrome.WindowChrome>
        <!-- cornice DWM sottile: ombra e angoli arrotondati di Windows 11 senza barra del titolo -->
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="0" GlassFrameThickness="0,0,0,1" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <app:NullToCollapsed x:Key="Visible"/>
        <app:BoolToVisible x:Key="IfTrue"/>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="16,16,16,10">
        <!-- intestazione: nome discreto a sinistra, livello in evidenza a destra -->
        <Grid Margin="2,0,2,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <Image Source="{StaticResource AppBrandIcon}" Width="18" Height="18" Margin="0,0,8,0"
                           RenderOptions.BitmapScalingMode="HighQuality" AutomationProperties.Name=""/>
                    <TextBlock Text="Battery Forecast" Style="{StaticResource Strong}" FontSize="14" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Text="{Binding PowerLine}" Style="{StaticResource Secondary}" FontSize="12" Margin="0,4,0,0"/>
                <TextBlock Text="{Binding SaverLine}" Style="{StaticResource Secondary}" FontSize="12" Foreground="{DynamicResource Saving}"
                           Visibility="{Binding SaverLine, Converter={StaticResource Visible}}" Margin="0,2,0,0"/>
                <TextBlock Text="{Binding HeldLine}" Style="{StaticResource Secondary}" FontSize="12"
                           Visibility="{Binding HeldLine, Converter={StaticResource Visible}}" Margin="0,2,0,0"/>
            </StackPanel>
            <TextBlock Grid.Column="1" Text="{Binding Level}" FontSize="34" FontWeight="SemiBold" VerticalAlignment="Center"
                       FontFamily="{StaticResource DisplayFont}" Typography.NumeralAlignment="Tabular"
                       AutomationProperties.Name="{Binding Level}"/>
        </Grid>

        <Border Background="{DynamicResource Demo}" CornerRadius="8" Padding="12,6" Margin="0,0,0,10"
                Visibility="{Binding DemoLine, Converter={StaticResource Visible}}">
            <TextBlock Text="{Binding DemoLine}" Foreground="{DynamicResource DemoText}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap"/>
        </Border>

        <!-- previsione: la card principale, con una leggera sfumatura -->
        <Border Background="{DynamicResource Hero}" BorderBrush="{DynamicResource HeroBorder}" BorderThickness="1"
                CornerRadius="14" Padding="16,14,16,12">
            <StackPanel>
                <Grid>
                    <TextBlock Text="{Binding SectionTitle}" Style="{StaticResource Eyebrow}"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <app:Spinner Width="12" Height="12" Margin="0,0,6,0" Visibility="{Binding Busy, Converter={StaticResource IfTrue}}"/>
                        <TextBlock Text="{Binding UpdatedAt}" Style="{StaticResource Footnote}" Foreground="{DynamicResource TextTertiary}"/>
                        <Button x:Name="RecalculateButton" Style="{StaticResource IconButton}" Width="28" Height="24"
                                Content="&#xE72C;" Click="Recalculate_Click" IsEnabled="{Binding CanRecalculate}"
                                AutomationProperties.HelpText="{app:T RecalculateNowHelp}" AutomationProperties.Name="{app:T RecalculateNow}" Margin="6,-4,-4,0"/>
                    </StackPanel>
                </Grid>

                <TextBlock Text="{app:T RecalculateInlineHelp}" Style="{StaticResource Footnote}" FontSize="10" Margin="0,4,0,0"
                           Foreground="{DynamicResource TextSecondary}"/>
                <StackPanel x:Name="ForecastBody" Margin="0,8,0,0">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Style.Triggers>
                                <!-- dati vecchi: si vedono, ma attenuati -->
                                <DataTrigger Binding="{Binding Stale}" Value="True">
                                    <Setter Property="Opacity" Value="0.55"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="{Binding Headline}" Style="{StaticResource Headline}" AutomationProperties.HeadingLevel="Level1"/>
                    <TextBlock Text="{Binding Detail}" Style="{StaticResource Secondary}" Margin="0,4,0,0"
                               Visibility="{Binding Detail, Converter={StaticResource Visible}}"/>
                    <TextBlock Text="{Binding Note}" Style="{StaticResource Footnote}" Margin="0,3,0,0"
                               Visibility="{Binding Note, Converter={StaticResource Visible}}"/>

                    <TextBlock Text="{Binding ExtraTargets}" Style="{StaticResource Secondary}" Margin="0,8,0,0"
                        Visibility="{Binding ExtraTargets, Converter={StaticResource Visible}}"/>
                    <TextBlock Text="{Binding HoverText, ElementName=Chart}" MinHeight="16" FontSize="11" Foreground="{DynamicResource TextSecondary}"
                               Visibility="{Binding Chart, Converter={StaticResource Visible}}"/>
                    <app:ForecastChart x:Name="Chart" Height="120" Margin="0,0,0,2" Forecast="{Binding Chart}"
                                       AutomationProperties.HelpText="{Binding ChartSummary}" AutomationProperties.Name="{app:T ChartExplore}"
                                       Visibility="{Binding Chart, Converter={StaticResource Visible}}"/>

                    <!-- riferimento cliccato: spazio riservato per evitare spostamenti durante il clic -->
                    <TextBlock Text="{Binding PinnedText, ElementName=Chart}" MinHeight="16" FontSize="11" Margin="0,3,0,0"
                               Foreground="{DynamicResource TextSecondary}" AutomationProperties.HelpText="{app:T ChartPinned}"
                               Visibility="{Binding Chart, Converter={StaticResource Visible}}"/>
                    <!-- obiettivo serale come una "pillola" -->
                    <Border Background="{DynamicResource RowHover}" CornerRadius="10" Padding="12,8" Margin="0,10,0,0"
                            Visibility="{Binding TargetLabel, Converter={StaticResource Visible}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="7" Height="7" Fill="{DynamicResource Accent}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{app:T ChartGoalLegend}" FontSize="10" Foreground="{DynamicResource TextSecondary}"/>
                                </StackPanel>
                                <TextBlock Text="{Binding TargetLabel}" Style="{StaticResource Body}"/>
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{Binding TargetRange}" Style="{StaticResource Secondary}" FontSize="12"
                                       VerticalAlignment="Center" Margin="8,0"/>
                            <TextBlock Grid.Column="2" Text="{Binding TargetValue}" Style="{StaticResource Strong}" FontSize="15"
                                       Foreground="{DynamicResource Accent}" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <StackPanel Margin="0,10,0,0">
                        <TextBlock Text="{Binding SourceLine}" Style="{StaticResource Footnote}"
                                   Visibility="{Binding SourceLine, Converter={StaticResource Visible}}"/>
                        <TextBlock Text="{Binding RechargeLine}" Style="{StaticResource Footnote}" Margin="0,3,0,0"
                                   Visibility="{Binding RechargeLine, Converter={StaticResource Visible}}"/>
                        <Expander Header="{app:T OtherEstimates}" IsExpanded="False" Margin="0,8,0,0" Padding="0"
                                  FontSize="12" Foreground="{DynamicResource TextSecondary}" Background="Transparent" BorderThickness="0"
                                  HorizontalContentAlignment="Stretch" AutomationProperties.HelpText="{Binding ComparisonHelp}"
                                  Visibility="{Binding HasComparisons, Converter={StaticResource IfTrue}}">
                            <StackPanel Margin="0,6,0,0">
                                <TextBlock Text="{Binding ComparisonHelp}" Style="{StaticResource Footnote}" Margin="0,0,0,5"/>
                                <TextBlock Text="{Binding RecentLine}" Style="{StaticResource Footnote}"
                                           Visibility="{Binding RecentLine, Converter={StaticResource Visible}}"/>
                                <TextBlock Text="{Binding WindowsLine}" Style="{StaticResource Footnote}" Margin="0,3,0,0"
                                           Visibility="{Binding WindowsLine, Converter={StaticResource Visible}}"/>
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </StackPanel>

                <Button Content="{app:T Retry}" Style="{StaticResource PillButton}" HorizontalAlignment="Left" Margin="0,10,0,0"
                        Click="Retry_Click" Visibility="{Binding CanRetry, Converter={StaticResource IfTrue}}"/>
            </StackPanel>
        </Border>

        <!-- proposta del risparmio energetico -->
        <Border Style="{StaticResource Card}" Margin="0,10,0,0" Visibility="{Binding SavingTitle, Converter={StaticResource Visible}}">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE8BE;" Style="{StaticResource Glyph}" Foreground="{DynamicResource Saving}" Margin="0,0,8,0"/>
                    <TextBlock Text="{Binding SavingTitle}" FontWeight="SemiBold" Foreground="{DynamicResource Saving}" TextWrapping="Wrap"/>
                </StackPanel>
                <TextBlock Text="{Binding SavingDetail}" Style="{StaticResource Secondary}" Margin="0,4,0,10"/>
                <Button Content="{app:T OpenSaverSettings}" Style="{StaticResource PillButton}" HorizontalAlignment="Left" Click="Saver_Click"/>
            </StackPanel>
        </Border>

        <!-- barra compatta: solo icone, il nome compare nel suggerimento e per gli screen reader -->
        <DockPanel Margin="0,10,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <ToggleButton x:Name="KeepOpen" Style="{StaticResource IconButton}" Width="38" Content="&#xE718;"
                              ToolTip="{app:T KeepOpen}" AutomationProperties.Name="{app:T KeepOpen}"/>
                <Button x:Name="MinimizeButton" Style="{StaticResource IconButton}" Width="38" Content="&#xE921;" Click="Minimize_Click"
                        AutomationProperties.Name="{app:T MinimizeToTray}"/>
                <Button Style="{StaticResource IconButton}" Width="38" Content="&#xE7E8;" Click="Quit_Click"
                        ToolTip="{app:T Quit}" AutomationProperties.Name="{app:T Quit}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource IconButton}" Width="38" Content="&#xE713;" Click="Prefs_Click"
                        ToolTip="{app:T Preferences}" AutomationProperties.Name="{app:T Preferences}"/>
                <Button Style="{StaticResource IconButton}" Width="38" Content="&#xE81C;" Click="History_Click"
                        ToolTip="{app:T History}" AutomationProperties.Name="{app:T History}"/>
                <Button Style="{StaticResource IconButton}" Width="38" Content="&#xE945;" Click="Power_Click"
                        ToolTip="{app:T OpenPowerSettings}" AutomationProperties.Name="{app:T OpenPowerSettings}"/>

            </StackPanel>
        </DockPanel>
    </StackPanel>
    </ScrollViewer>
</Window>
