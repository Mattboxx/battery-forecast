<Window x:Class="BatteryForecast.App.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="clr-namespace:BatteryForecast.App"
        Title="{app:T HistoryTitle}" Width="560" Height="640" MinWidth="420" MinHeight="400"
        WindowStartupLocation="CenterScreen" Style="{StaticResource AppWindow}">
    <Window.Resources>
        <app:NullToCollapsed x:Key="Visible"/>
    </Window.Resources>
    <Grid Margin="24,20,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="{app:T HealthTitle}" Style="{StaticResource SectionTitle}"/>
                <TextBlock Text="{Binding HealthValue}" Style="{StaticResource Headline}" Margin="0,4,0,0"
                           Visibility="{Binding HealthValue, Converter={StaticResource Visible}}"/>
                <TextBlock Text="{Binding HealthDetail}" Style="{StaticResource Secondary}" Margin="0,2,0,0"/>
                <TextBlock Text="{Binding HealthNote}" Style="{StaticResource Footnote}" Margin="0,4,0,0"
                           Visibility="{Binding HealthNote, Converter={StaticResource Visible}}"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,10,0,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="{app:T SegmentsTitle}" Style="{StaticResource SectionTitle}"/>
                    <TextBlock Text="{app:T SegmentsNote}" Style="{StaticResource Footnote}" Margin="0,2,0,8"/>
                    <TextBlock x:Name="Empty" Text="{app:T NoSegments}" Style="{StaticResource Secondary}" Visibility="Collapsed"/>
                </StackPanel>
                <ListView x:Name="Rows" ItemsSource="{Binding Segments}" BorderThickness="0" Background="Transparent"
                          AutomationProperties.Name="{app:T SegmentsTitle}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="60"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Day}" Style="{StaticResource Secondary}"/>
                                <TextBlock Grid.Column="1" Text="{Binding Change}" Style="{StaticResource Body}"/>
                                <TextBlock Grid.Column="2" Text="{Binding Rate}" Style="{StaticResource Secondary}" HorizontalAlignment="Right"/>
                                <TextBlock Grid.Column="3" Text="{Binding Energy}" Style="{StaticResource Secondary}" HorizontalAlignment="Right"/>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </DockPanel>
        </Border>

        <DockPanel Grid.Row="2" Margin="0,12,0,0">
            <TextBlock Text="{Binding Coverage}" Style="{StaticResource Footnote}" VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{app:T ExportCsv}" Click="Export_Click" Padding="12,5" Margin="0,0,8,0"/>
                <Button Content="{app:T Close}" IsCancel="True" Click="Close_Click" Padding="18,5"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
