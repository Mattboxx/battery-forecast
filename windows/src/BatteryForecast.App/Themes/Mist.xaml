<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Nebbia: grigio azzurro neutro, accento blu. Generato da uno script: tenere le stesse chiavi in tutti i temi. -->
    <SolidColorBrush x:Key="WindowBg" Color="#F2F4F7"/>
    <SolidColorBrush x:Key="WindowBorder" Color="#DCE1E8"/>
    <SolidColorBrush x:Key="CardBg" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="RowHover" Color="#E7EBF1"/>
    <SolidColorBrush x:Key="Text" Color="#161A20"/>
    <SolidColorBrush x:Key="TextSecondary" Color="#545C67"/>
    <SolidColorBrush x:Key="TextTertiary" Color="#6E7682"/>
    <SolidColorBrush x:Key="Accent" Color="#2457C5"/>
    <SolidColorBrush x:Key="AccentText" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Curve" Color="#2F6FD6"/>
    <SolidColorBrush x:Key="Grid" Color="#E3E7EE"/>
    <SolidColorBrush x:Key="Reserve" Color="#C2412D"/>
    <SolidColorBrush x:Key="Saving" Color="#167351"/>
    <SolidColorBrush x:Key="Demo" Color="#FFF1D6"/>
    <SolidColorBrush x:Key="DemoText" Color="#6B4300"/>
    <SolidColorBrush x:Key="Focus" Color="#161A20"/>
    <SolidColorBrush x:Key="Icon" Color="#545C67"/>
    <SolidColorBrush x:Key="Band" Color="#2F6FD6" Opacity="0.22"/>
    <Color x:Key="BandColor">#2F6FD6</Color>
    <SolidColorBrush x:Key="HeroBorder" Color="#D8E3F5"/>
    <LinearGradientBrush x:Key="Hero" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#EAF1FC" Offset="0"/>
        <GradientStop Color="#FFFFFF" Offset="1"/>
    </LinearGradientBrush>
</ResourceDictionary>
