<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Notte: quasi nero, adatto agli schermi OLED e alla sera. Generato da uno script: tenere le stesse chiavi in tutti i temi. -->
    <SolidColorBrush x:Key="WindowBg" Color="#0B0B10"/>
    <SolidColorBrush x:Key="WindowBorder" Color="#24242E"/>
    <SolidColorBrush x:Key="CardBg" Color="#15151D"/>
    <SolidColorBrush x:Key="RowHover" Color="#1F1F2A"/>
    <SolidColorBrush x:Key="Text" Color="#EDEDF2"/>
    <SolidColorBrush x:Key="TextSecondary" Color="#A9A9B8"/>
    <SolidColorBrush x:Key="TextTertiary" Color="#83839A"/>
    <SolidColorBrush x:Key="Accent" Color="#F5B04A"/>
    <SolidColorBrush x:Key="AccentText" Color="#120D05"/>
    <SolidColorBrush x:Key="Curve" Color="#9FB4FF"/>
    <SolidColorBrush x:Key="Grid" Color="#26262F"/>
    <SolidColorBrush x:Key="Reserve" Color="#FF7A6B"/>
    <SolidColorBrush x:Key="Saving" Color="#6FCF97"/>
    <SolidColorBrush x:Key="Demo" Color="#2C220F"/>
    <SolidColorBrush x:Key="DemoText" Color="#F5C77A"/>
    <SolidColorBrush x:Key="Focus" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Icon" Color="#A9A9B8"/>
    <SolidColorBrush x:Key="Band" Color="#9FB4FF" Opacity="0.22"/>
    <Color x:Key="BandColor">#9FB4FF</Color>
    <SolidColorBrush x:Key="HeroBorder" Color="#2A2A36"/>
    <LinearGradientBrush x:Key="Hero" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#1A1A26" Offset="0"/>
        <GradientStop Color="#13131A" Offset="1"/>
    </LinearGradientBrush>
</ResourceDictionary>
