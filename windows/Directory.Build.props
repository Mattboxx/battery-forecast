<Project>
  <PropertyGroup>
    <!-- Windows 10 2004+ per le API WinRT della batteria; l'app è provata su Windows 11 x64. -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <!-- x64 per lo sviluppo; la release arm64 passa -r win-arm64 (tools\package.ps1 -Arch arm64) -->
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
    <Platforms>x64;ARM64</Platforms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Keep self-contained runtime packs aligned with the audited notices in tools/licenses.py.
         A newer SDK/runner must not silently choose another runtime during publishing. -->
    <TargetLatestRuntimePatch>false</TargetLatestRuntimePatch>
    <Version>0.9.5</Version>
    <Authors>Mattboxx</Authors>
    <Company>Mattboxx</Company>
    <Copyright>Copyright (c) 2026 Matteo Bonfanti (Till Dusk); Copyright (c) 2026 Mattboxx (Battery Forecast)</Copyright>
    <Product>Battery Forecast</Product>
  </PropertyGroup>
  <Target Name="PinAuditedRuntimePacks" BeforeTargets="ProcessFrameworkReferences">
    <ItemGroup>
      <!-- Scope the pin to runtimes: the Windows SDK reference has its own version. -->
      <FrameworkReference Update="Microsoft.NETCore.App;Microsoft.WindowsDesktop.App;Microsoft.WindowsDesktop.App.WPF;Microsoft.WindowsDesktop.App.WindowsForms"
                          RuntimeFrameworkVersion="10.0.13" />
    </ItemGroup>
  </Target>
</Project>
