<Window x:Class="BatteryForecast.App.PreferencesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="clr-namespace:BatteryForecast.App"
        Title="{app:T PrefsTitle}" Width="520" SizeToContent="Height" ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen" Style="{StaticResource AppWindow}">
    <Window.Resources>
        <Style x:Key="Help" TargetType="TextBlock" BasedOn="{StaticResource Footnote}">
            <Setter Property="Margin" Value="0,4,0,0"/>
        </Style>
        <Style x:Key="Label" TargetType="TextBlock" BasedOn="{StaticResource Body}">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
        </Style>
    </Window.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,20,24,20">
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="160"/></Grid.ColumnDefinitions>
                        <TextBlock Text="{app:T PrefReserve}" Style="{StaticResource Label}"/>
                        <TextBox x:Name="Reserve" Grid.Column="1" AutomationProperties.Name="{app:T PrefReserve}"/>
                    </Grid>
                    <TextBlock Text="{app:T PrefReserveHelp}" Style="{StaticResource Help}"/>
                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="160"/></Grid.ColumnDefinitions>
                        <TextBlock Text="{app:T PrefTarget}" Style="{StaticResource Label}"/>
                        <TextBox x:Name="Target" Grid.Column="1" AutomationProperties.Name="{app:T PrefTarget}"/>
                    </Grid>
                    <TextBlock Text="{app:T ManualTimeHelp}" Style="{StaticResource Help}"/>
                    <TextBlock Text="{app:T ExtraTimes}" Style="{StaticResource Label}" Margin="0,12,0,4"/>
                    <TextBox x:Name="ExtraTimes" AutomationProperties.Name="{app:T ExtraTimes}"/>
                    <TextBlock Text="{app:T ChargeTargetLabel}" Style="{StaticResource Label}" Margin="0,12,0,4"/>
                    <TextBox x:Name="ChargeTarget" AutomationProperties.Name="{app:T ChargeTargetLabel}"/>
                    <TextBlock Text="{app:T ChargeTargetHelp}" Style="{StaticResource Help}"/>
                    <TextBlock Text="{app:T HotkeyLabel}" Style="{StaticResource Label}" Margin="0,12,0,4"/>
                    <!-- registratore: si preme la combinazione invece di scriverla -->
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button x:Name="HotkeyChange" Content="{app:T HotkeyChange}" Click="HotkeyChange_Click" Padding="12,5" Margin="8,0,0,0"/>
                            <Button Content="{app:T HotkeyDefault}" Click="HotkeyDefault_Click" Padding="12,5" Margin="8,0,0,0"/>
                            <Button Content="{app:T HotkeyDisable}" Click="HotkeyDisable_Click" Padding="12,5" Margin="8,0,0,0"/>
                        </StackPanel>
                        <Border x:Name="HotkeyBox" Focusable="True" BorderThickness="1" BorderBrush="{DynamicResource WindowBorder}"
                                Background="{DynamicResource RowHover}" CornerRadius="6" Padding="12,6" FocusVisualStyle="{StaticResource FocusRing}"
                                AutomationProperties.Name="{app:T HotkeyLabel}">
                            <TextBlock x:Name="HotkeyText" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center"/>
                        </Border>
                    </DockPanel>
                    <TextBlock x:Name="HotkeyStatus" Style="{StaticResource Help}"/>
                    <TextBlock Text="{app:T HotkeyHelp}" Style="{StaticResource Help}"/>
                    <Button Content="{app:T ApplyCustom}" Click="Custom_Click" HorizontalAlignment="Left" Margin="0,12,0,0" Padding="12,5"/>
                    <TextBlock x:Name="CustomStatus" Style="{StaticResource Help}"/>
                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="220"/></Grid.ColumnDefinitions>
                        <TextBlock Text="{app:T PrefRefresh}" Style="{StaticResource Label}"/>
                        <ComboBox x:Name="RefreshBox" Grid.Column="1" AutomationProperties.Name="{app:T PrefRefresh}"/>
                    </Grid>
                    <TextBlock Text="{app:T PrefRefreshHelp}" Style="{StaticResource Help}"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,10,0,0">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="160"/></Grid.ColumnDefinitions>
                        <TextBlock Text="{app:T PrefTheme}" Style="{StaticResource Label}"/>
                        <ComboBox x:Name="ThemeBox" Grid.Column="1" AutomationProperties.Name="{app:T PrefTheme}"/>
                    </Grid>
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="160"/></Grid.ColumnDefinitions>
                        <TextBlock Text="{app:T PrefLanguage}" Style="{StaticResource Label}"/>
                        <ComboBox x:Name="LanguageBox" Grid.Column="1" AutomationProperties.Name="{app:T PrefLanguage}"/>
                    </Grid>
                    <CheckBox x:Name="ShowChart" Content="{app:T ShowChart}" Margin="0,12,0,0"/>
                    <CheckBox x:Name="KeepOpenDefault" Content="{app:T KeepOpenDefault}" Margin="0,10,0,0"/>
                    <CheckBox x:Name="OpenOnHover" Content="{app:T OpenOnHover}" Margin="0,10,0,0"/>
                    <TextBlock Text="{app:T OpenOnHoverHelp}" Style="{StaticResource Help}"/>
                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition/><ColumnDefinition Width="64"/></Grid.ColumnDefinitions>
                        <TextBlock Text="{app:T PanelScale}" Style="{StaticResource Label}"/>
                        <Slider x:Name="ScaleSlider" Grid.Column="1" Minimum="0.8" Maximum="1.6" TickFrequency="0.05" IsSnapToTickEnabled="True"
                                SmallChange="0.05" LargeChange="0.1" VerticalAlignment="Center" AutomationProperties.Name="{app:T PanelScale}"/>
                        <TextBlock x:Name="ScaleValue" Grid.Column="2" Style="{StaticResource Body}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition/><ColumnDefinition Width="64"/></Grid.ColumnDefinitions>
                        <TextBlock Text="{app:T PanelWidth}" Style="{StaticResource Label}"/>
                        <Slider x:Name="WidthSlider" Grid.Column="1" Minimum="320" Maximum="640" TickFrequency="8" IsSnapToTickEnabled="True"
                                SmallChange="8" LargeChange="32" VerticalAlignment="Center" AutomationProperties.Name="{app:T PanelWidth}"/>
                        <TextBlock x:Name="WidthValue" Grid.Column="2" Style="{StaticResource Body}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                    <TextBlock Text="{app:T PanelSizeHelp}" Style="{StaticResource Help}"/>
                    <Button Content="{app:T PanelSizeReset}" Style="{StaticResource LinkButton}" HorizontalAlignment="Left" Margin="0,6,0,0" Click="SizeReset_Click"/>
                    <CheckBox x:Name="TrayPercent" Margin="0,14,0,0" Content="{app:T PrefTray}"/>
                    <TextBlock Text="{app:T PrefTrayHelp}" Style="{StaticResource Help}"/>
                    <CheckBox x:Name="Login" Margin="0,12,0,0" Content="{app:T PrefLogin}"/>
                    <TextBlock Text="{app:T PrefLoginHelp}" Style="{StaticResource Help}"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,10,0,0">
                <StackPanel>
                    <TextBlock Text="{app:T PrefNotifications}" Style="{StaticResource SectionTitle}"/>
                    <CheckBox x:Name="NotifyEnabled" Margin="0,8,0,0" Content="{app:T PrefNotifyEnabled}"/>
                    <StackPanel x:Name="NotifyOptions" Margin="28,4,0,0">
                        <TextBlock Text="{app:T AlertMinutesCustom}" Style="{StaticResource Label}"/>
                        <TextBox x:Name="AlertMinutes" AutomationProperties.Name="{app:T AlertMinutesCustom}" Margin="0,4,0,0"/>
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="160"/></Grid.ColumnDefinitions>
                            <TextBlock Text="{app:T PrefNotifyLow}" Style="{StaticResource Label}"/>
                            <TextBox x:Name="NotifyLow" Grid.Column="1" AutomationProperties.Name="{app:T PrefNotifyLow}"/>
                        </Grid>
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="160"/></Grid.ColumnDefinitions>
                            <TextBlock Text="{app:T PrefNotifyCharged}" Style="{StaticResource Label}"/>
                            <TextBox x:Name="NotifyCharged" Grid.Column="1" AutomationProperties.Name="{app:T PrefNotifyCharged}"/>
                        </Grid>
                        <CheckBox x:Name="NotifyDrain" Margin="0,8,0,0" Content="{app:T PrefNotifyDrain}"/>
                    </StackPanel>
                    <CheckBox x:Name="QuietEnabled" Content="{app:T QuietEnabled}" Margin="0,12,0,0"/>
                    <Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <StackPanel><TextBlock Text="{app:T QuietStart}" Style="{StaticResource Label}"/><TextBox x:Name="QuietStart" AutomationProperties.Name="{app:T QuietStart}" Margin="0,4,8,0"/></StackPanel>
                        <StackPanel Grid.Column="1"><TextBlock Text="{app:T QuietEnd}" Style="{StaticResource Label}"/><TextBox x:Name="QuietEnd" AutomationProperties.Name="{app:T QuietEnd}" Margin="0,4,0,0"/></StackPanel>
                    </Grid>
                    <TextBlock Text="{app:T QuietHelp}" Style="{StaticResource Help}"/>
                    <Button Content="{app:T ApplyCustom}" Click="Custom_Click" HorizontalAlignment="Left" Margin="0,10,0,0" Padding="12,5"/>
                    <TextBlock x:Name="NotifyCustomStatus" Style="{StaticResource Help}"/>
                    <TextBlock Text="{app:T PrefNotifyHelp}" Style="{StaticResource Help}"/>
                    <Button Content="{app:T TestNotification}" Click="TestNotify_Click" HorizontalAlignment="Left" Margin="0,10,0,0" Padding="12,5"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,10,0,0">
                <StackPanel>
                    <TextBlock Text="{app:T PrefData}" Style="{StaticResource SectionTitle}"/>
                    <CheckBox x:Name="CollectContext" Content="{app:T CollectContext}" Margin="0,10,0,0"/>
                    <CheckBox x:Name="UseContext" Content="{app:T UseContext}" Margin="0,8,0,0"/>
                    <TextBlock Text="{app:T ContextHelp}" Style="{StaticResource Help}"/>
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="160"/></Grid.ColumnDefinitions>
                        <TextBlock Text="{app:T PrefRetention}" Style="{StaticResource Label}"/>
                        <ComboBox x:Name="Retention" Grid.Column="1" AutomationProperties.Name="{app:T PrefRetention}"/>
                    </Grid>
                    <WrapPanel Margin="0,12,0,0">
                        <Button Content="{app:T ExportContext}" Click="ExportContext_Click" Padding="12,5" Margin="0,0,8,8"/>
                        <Button Content="{app:T ExportCsv}" Click="Export_Click" Margin="0,0,8,0" Padding="12,5"/>
                        <Button Content="{app:T DeleteHistory}" Click="Delete_Click" Padding="12,5"/>
                        <Button Content="{app:T Diagnostics}" Click="Diagnostics_Click" Padding="12,5" Margin="0,8,0,0"/>
                    </WrapPanel>
                    <TextBlock Text="{app:T DiagnosticsHelp}" Style="{StaticResource Help}"/>
                    <TextBlock x:Name="DataNote" Style="{StaticResource Help}" Visibility="Collapsed"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,10,0,0">
                <StackPanel>
                    <TextBlock Text="{app:T PrefAbout}" Style="{StaticResource SectionTitle}"/>
                    <TextBlock x:Name="About" Style="{StaticResource Secondary}" Margin="0,6,0,0"/>
                    <WrapPanel Margin="0,12,0,0">
                        <Button x:Name="CheckButton" Content="{app:T UpdateCheck}" Click="CheckUpdates_Click" Padding="12,5" Margin="0,0,8,0"/>
                        <Button x:Name="InstallButton" Content="{app:T UpdateInstall}" Click="InstallUpdate_Click" Padding="12,5" Margin="0,0,8,0"
                                Style="{StaticResource PillButton}" Visibility="Collapsed"/>
                    </WrapPanel>
                    <TextBlock x:Name="UpdateStatus" Style="{StaticResource Help}" Visibility="Collapsed"/>
                    <Button x:Name="NotesButton" Content="{app:T UpdateNotes}" Style="{StaticResource LinkButton}" HorizontalAlignment="Left"
                            Margin="0,4,0,0" Click="Notes_Click" Visibility="Collapsed"/>
                    <CheckBox x:Name="AutoUpdate" Margin="0,10,0,0" Content="{app:T UpdateAuto}"/>
                    <TextBlock Text="{app:T UpdateAutoHelp}" Style="{StaticResource Help}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Content="{app:T Licenses}" Style="{StaticResource LinkButton}" Click="Licenses_Click" Margin="0,0,18,0"/>
                        <!-- sostegno: un link discreto, mai un invito ripetuto -->
                        <TextBlock Text="&#xEB51;" Style="{StaticResource Glyph}" FontSize="12" Foreground="{DynamicResource Accent}" Margin="0,0,6,0"/>
                        <Button Content="{app:T Support}" Style="{StaticResource LinkButton}" Click="Support_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Button Content="{app:T Close}" HorizontalAlignment="Right" Margin="0,16,0,0" Padding="18,5" IsCancel="True" IsDefault="True" Click="Close_Click"/>
        </StackPanel>
    </ScrollViewer>
</Window>
